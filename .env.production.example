# ========================================================
# PRODUCTION Environment Variables
# ========================================================
# Copy this file to your hosting platform's environment
# variable settings (e.g. Vercel → Settings → Environment
# Variables). Do NOT commit secrets to source control.
# ========================================================

# ----- Database -----
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?appName=<app>"
# MONGODB_DB_NAME=                           # override DB name if needed

# ----- Auth -----
SECRET_KEY="<strong-random-secret>"          # used for JWT signing — change from the dev default!

# ----- Base URLs (REQUIRED for production) -----
# These MUST point to your live domain. Without them, email
# links, webhook URLs, and server-side fetches will break.
NEXT_PUBLIC_BASE_URL=https://yourdomain.com
NEXT_PUBLIC_API_BASE_URL=https://yourdomain.com/api
NODE_ENV=production

# ----- Email (SMTP) -----
NODEMAILER_HOST=smtp.gmail.com
NODEMAILER_PORT=587
NODEMAILER_EMAIL=<your-email>
NODEMAILER_PASSWORD=<your-app-password>

# ----- Cloudinary -----
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=<cloud-name>
NEXT_PUBLIC_CLOUDINARY_API_KEY=<api-key>
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=<preset>
CLOUDINARY_SECRET_KEY=<secret>

# ----- Razorpay -----
NEXT_PUBLIC_RAZORPAY_KEY_ID=<key-id>
RAZORPAY_KEY_SECRET=<key-secret>

# ----- Brand -----
NEXT_PUBLIC_BRAND_NAME=ELOIR
# NEXT_PUBLIC_BRAND_ADDRESS=...              # printed on invoice PDF
# NEXT_PUBLIC_BRAND_GSTIN=...                # printed on invoice PDF

# ----- Returns -----
# RETURN_WINDOW_DAYS=7
# NEXT_PUBLIC_RETURN_ADDRESS=...

# ----- Logging -----
# LOG_LEVEL=warn
